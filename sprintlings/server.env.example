# Copy to server.env (never commit the real file) and fill in.
PORT=8787
STORAGE=postgres
DATABASE_URL=postgres://user:password@host:5432/sprintlings
# Public https address of this server (used for Stripe return pages).
PUBLIC_URL=https://api.example.com
# Browser origins allowed to call the API. The API uses bearer tokens (no cookies),
# so "*" is safe; or list the portal origins, comma separated.
CORS_ORIGINS=*
# Payments: stripe (live/test keys) or none.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# One Stripe Price per product id (see src/config/ProductCatalog.ts), e.g.:
# STRIPE_PRICE_STARTER_PACK=price_...
# STRIPE_PRICE_GEMS_500=price_...
# STRIPE_PRICE_GEMS_1200=price_...
# STRIPE_PRICE_GEMS_3000=price_...
# STRIPE_PRICE_GEMS_7000=price_...
# STRIPE_PRICE_BUNDLE_WANDERER=price_...
# STRIPE_PRICE_AD_FREE=price_...
