# Copy to .env.gamemonetize and fill in, then: npm run build:gamemonetize
# Game ID from the GameMonetize dashboard (enables ads).
VITE_GAMEMONETIZE_GAME_ID=
# Your deployed game server (https). Enables accounts, online races and verified rewards.
VITE_SERVER_URL=https://api.example.com
# Real-money purchases through the server's Stripe checkout (only with VITE_SERVER_URL).
VITE_ENABLE_PURCHASES=false
# Shown in the Terms of Service / Privacy Policy.
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_LEGAL_EMAIL=
VITE_LEGAL_COUNTRY=
